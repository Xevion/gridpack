{
	"name": "gridpack",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "tempo check",
		"check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"fmt": "tempo fmt",
		"hooks:install": "lefthook install",
		"knip": "knip",
		"lint": "tempo lint",
		"prepare": "svelte-kit sync && panda codegen && (lefthook install || true)",
		"preview": "vite preview",
		"sort:pkg": "sort-package-json",
		"spell": "cspell --no-progress --gitignore \"**/*.{ts,js,svelte,md}\"",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ark-ui/svelte": "^5.24.2",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource/source-sans-pro": "^5.3.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@pandacss/dev": "^1.12.1",
		"@pandacss/eslint-plugin": "^0.3.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.66.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@xevion/tempo": "^0.2.0",
		"cspell": "^10.3.3",
		"eslint": "^10.11.0",
		"eslint-plugin-perfectionist": "^5.11.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"knip": "^6.37.0",
		"lefthook": "^2.1.14",
		"postcss": "^8.5.15",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"sort-package-json": "^4.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.10"
	},
	"packageManager": "bun@1.4.2"
}
